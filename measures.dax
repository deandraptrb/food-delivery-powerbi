// ============================================================
// Online Food Ordering - DAX measures
// Put all measures in one empty table called "_Measures"
// (Home > Enter data > name the table _Measures > Load)
// All measures exclude duplicate rows (IsDuplicate = 1) by default
// ============================================================

// ---------- Base ----------
Responses =
CALCULATE ( COUNTROWS ( FactResponse ), FactResponse[IsDuplicate] = 0 )

Order Again Count =
CALCULATE ( [Responses], FactResponse[OrderAgain] = "Yes" )

Positive Count =
CALCULATE ( [Responses], FactResponse[Feedback] = "Positive" )

Negative Count =
CALCULATE ( [Responses], FactResponse[Feedback] = "Negative" )

// ---------- Rates ----------
Order Again Rate =
DIVIDE ( [Order Again Count], [Responses] )

Positive Rate =
DIVIDE ( [Positive Count], [Responses] )

Negative Rate =
DIVIDE ( [Negative Count], [Responses] )

// ---------- Benchmark vs overall ----------
Overall Order Again Rate =
CALCULATE ( [Order Again Rate], REMOVEFILTERS () )

Overall Positive Rate =
CALCULATE ( [Positive Rate], REMOVEFILTERS () )

Order Again vs Avg (pp) =
( [Order Again Rate] - [Overall Order Again Rate] ) * 100

Positive vs Avg (pp) =
( [Positive Rate] - [Overall Positive Rate] ) * 100

// Used for conditional bar color (above / below average)
Order Again Color =
IF ( [Order Again Rate] >= [Overall Order Again Rate], "#2E6F73", "#B0BBBF" )

// ---------- Feedback x Order Again ----------
Order Again Rate | Positive =
CALCULATE ( [Order Again Rate], FactResponse[Feedback] = "Positive" )

Order Again Rate | Negative =
CALCULATE ( [Order Again Rate], FactResponse[Feedback] = "Negative" )

Feedback Gap (pp) =
( [Order Again Rate | Positive] - [Order Again Rate | Negative] ) * 100

// Customers who gave negative feedback but still ordered again
Unhappy but Loyal =
CALCULATE (
    [Responses],
    FactResponse[Feedback] = "Negative",
    FactResponse[OrderAgain] = "Yes"
)

// Satisfied customers who did not order again -> win-back opportunity
Happy but Lost =
CALCULATE (
    [Responses],
    FactResponse[Feedback] = "Positive",
    FactResponse[OrderAgain] = "No"
)

// ---------- Profile ----------
Avg Age =
CALCULATE ( AVERAGE ( FactResponse[Age] ), FactResponse[IsDuplicate] = 0 )

Avg Family Size =
CALCULATE ( AVERAGE ( FactResponse[FamilySize] ), FactResponse[IsDuplicate] = 0 )

Share of Responses =
DIVIDE ( [Responses], CALCULATE ( [Responses], REMOVEFILTERS () ) )

// ---------- Ranking ----------
Occupation Rank (Order Again) =
IF (
    HASONEVALUE ( DimOccupation[Occupation] ),
    RANKX ( ALLSELECTED ( DimOccupation[Occupation] ), [Order Again Rate], , DESC, DENSE )
)

// Flags segments with a small sample (< 15 responses) so insights stay fair
Low Sample Flag =
IF ( [Responses] < 15, "Low sample", BLANK () )

// ---------- Dynamic text for cards / subtitles ----------
Headline Order Again =
VAR r = [Order Again Rate]
VAR diff = [Order Again vs Avg (pp)]
RETURN
    FORMAT ( r, "0.0%" ) & " order again ("
        & IF ( diff >= 0, "+", "" ) & FORMAT ( diff, "0.0" ) & " pp vs avg)"

Selected Segment Label =
IF (
    ISFILTERED ( DimOccupation[Occupation] ),
    CONCATENATEX ( VALUES ( DimOccupation[Occupation] ), DimOccupation[Occupation], ", " ),
    "All occupations"
)
